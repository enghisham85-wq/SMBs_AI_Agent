{
  "name": "@workspace/boosthis-runtime-web",
  "version": "1.0.0-alpha.130",
  "private": true,
  "type": "module",
  "description": "Boosthis performance runtime for websites / web apps (browser Web Vitals). Same scoring model and PII guard as the React Native, Python, and Node runtimes.",
  "exports": {
    ".": "./src/index.ts",
    "./mcp": "./src/mcp.ts",
    "./checklist": "./src/checklist.ts",
