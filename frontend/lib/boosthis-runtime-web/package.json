    "mcp": "tsx src/mcp-stdio.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.18.3",
    "tsx": "^4.21.0",
    "vitest": "catalog:",
    "vue": "^3.5.42",
    "vue-router": "^4.5.1"
  }
}
